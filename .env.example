# Optional. Enables posters, backdrops, ratings and trailers from TMDB during `npm run sync`.
# Get a free v3 API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Or a TMDB v4 read access token instead of the key.
TMDB_READ_TOKEN=

# Where the library (and Wikidata) can reach whoever runs this, sent in the User-Agent.
# On Vercel it defaults to the GitHub repo being deployed; set it for local or other hosts.
CONTACT_URL=

# Optional. Adds IMDb ratings (and fills RT/Metacritic gaps) during `npm run enrich`.
OMDB_API_KEY=

# Override the public site address (canonical URLs, sitemap, social cards).
# Production builds default to https://localshelf.uk.
NEXT_PUBLIC_SITE_URL=

# The repo URL, used as the default CONTACT_URL. On Vercel it defaults to the GitHub repo being deployed.
NEXT_PUBLIC_SOURCE_URL=

# Sync relay. The catalogue only answers UK traffic, so GitHub's (US) runners fetch it through
# the site's /api/relay, which runs in London. Set the same random token, 32+ characters
# (openssl rand -hex 32), on Vercel (enables the relay) and as a GitHub Actions secret. SPYDUS_RELAY_URL is only set in the Action.
SPYDUS_RELAY_TOKEN=
SPYDUS_RELAY_URL=
